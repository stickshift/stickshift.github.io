<!DOCTYPE html>

{% import "base.j2" as ss with context %}

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{{ page.description }}">
    <title>{{ site.title }} - {{ page.title }}</title>

    <!-- css -->
    {% for stylesheet in site.stylesheets %}
    <link rel="stylesheet" href="{{ stylesheet }}">
    {% endfor %}
    <!-- /css -->

    <!-- mathjax -->
    <script>
        MathJax = {
            tex: {
                inlineMath: [['$', '$']],
                tags: 'ams' // Support numbered eqs
            }
        };
    </script>
    <script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-svg.js"></script>
    <!-- /mathjax -->

    <!-- google analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-B29S0R6EYD"></script>
    <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-B29S0R6EYD');
    </script>
    <!-- /google analytics -->
</head>
<body>
    <header>
        <div class="navbar">
            <a href="{{ site.root_url }}">{{ site.title }}</a>
            <a href="{{ site.repo_url }}">{{ ss.icon("github") }}</a>
        </div>
    </header>

    <main>
        {% block toc %}{% endblock %}

        {% block main %}{% endblock %}
    </main>

    <footer>
        <div class="content">
            <h1>{{ site.title }}</h1>
            <div class="columns">
                <div class="column column1">
                    <h2>{{ page.author.name }}</h2>
                </div>
                <div class="column column2">
                    <ul>
                        <li>
                            <a href="https://github.com/{{ page.author.github }}">
                                {{ ss.icon("github") | indent(28) }}
                                <span class="username">{{ page.author.github }}</span>
                            </a>
                        </li>
                        <li>
                            <a href="https://www.linkedin.com/in/{{ page.author.linkedin }}">
                                {{ ss.icon("linkedin") | indent(28) }}
                                <span class="username">{{ page.author.linkedin }}</span>
                            </a>
                        </li>
                    </ul>
                </div>
                <div class="column column3">
                    <p>{{ page.author.bio }}</p>
                </div>
            </div>
        </div>
    </footer>

</body>
</html>
